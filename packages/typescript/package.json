{
  "name": "@infobits/intl",
  "version": "0.0.0-managed-by-ci",
  "description": "Internationalization data for countries, languages, currencies, and continents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "countries",
    "languages",
    "currencies",
    "continents",
    "flags",
    "localization"
  ],
  "author": "Infobits",
  "license": "MIT",
  "homepage": "https://docs.infobits.io/packages/typescript/infobits-intl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infobits-io/infobits-intl.git",
    "directory": "packages/typescript"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
