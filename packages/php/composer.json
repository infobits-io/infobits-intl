{
    "name": "infobits/intl",
    "description": "Internationalization data: countries, languages, currencies, continents with i18n translations",
    "type": "library",
    "license": "MIT",
    "keywords": ["i18n", "intl", "countries", "languages", "currencies", "continents", "translations"],
    "homepage": "https://docs.infobits.io/packages/php/infobits-intl",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Infobits\\Intl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Infobits\\Intl\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
