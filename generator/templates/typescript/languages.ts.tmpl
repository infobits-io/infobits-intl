// GENERATED CODE - DO NOT MODIFY BY HAND

import type { Language } from './types';

export enum LanguageCode {
{{- range .}}
  {{upper .Code}} = "{{.Code}}",
{{- end}}
}

export const languages: Record<LanguageCode, Language> = {
{{- range .}}
  [LanguageCode.{{upper .Code}}]: {
    id: "{{.ID}}",
    code: "{{.Code}}",
    nativeName: "{{escapeString .NativeName}}",
    dialects: [{{range $i, $d := .Dialects}}{{if $i}}, {{end}}{id: "{{$d.ID}}", code: "{{$d.Code}}", nativeName: "{{escapeString $d.NativeName}}", flagCode: "{{$d.FlagCode}}"}{{end}}] as const,
{{- if .DefaultFlagCode}}
    defaultFlagCode: "{{.DefaultFlagCode}}",
{{- end}}
  },
{{- end}}
} as const;

// Lookup functions
export function getLanguageByCode(code: string): Language | undefined {
  return languages[code.toLowerCase() as LanguageCode];
}

export function getEmojiFlagFromLanguage(languageCode: string): string | undefined {
  const lang = getLanguageByCode(languageCode);
  if (!lang?.defaultFlagCode) return undefined;
  const code = lang.defaultFlagCode.toUpperCase();
  const base = 0x1F1E6 - 65;
  const first = code.charCodeAt(0) + base;
  const second = code.charCodeAt(1) + base;
  return String.fromCodePoint(first, second);
}
